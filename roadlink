#!/usr/bin/env python3
"""RoadLink diagnostics, private AP configuration and recovery CLI."""
import argparse
import json
import sys
import os
import getpass
import secrets
from pathlib import Path
sys.path.insert(0, str(Path(__file__).resolve().parent / 'src'))
from status import snapshot
from hardware import capabilities
from storage import load_json, write_json
from ap_config import hostapd

parser = argparse.ArgumentParser(description='RoadLink network diagnostics')
parser.add_argument('command', choices=['status', 'hardware', 'diagnostics', 'configure-ap', 'ap-status', 'safe-mode'])
parser.add_argument('--ssid', default='breschdleng-roadlink')
parser.add_argument('--generate', action='store_true', help='Generate a private AP password on this device')
args = parser.parse_args()
if args.command == 'configure-ap':
    if os.geteuid() != 0:
        parser.error('Root required')
    password = secrets.token_urlsafe(18) if args.generate else getpass.getpass('Fahrzeug-WLAN-Passwort: ')
    hostapd('aproadlink', args.ssid, password)
    write_json('/data/setupOptions/RoadLink/ap-secret.json', {'password': password})
    import dbus
    obj = dbus.SystemBus().get_object('com.victronenergy.settings', '/Settings/RoadLink/AP/SSID')
    dbus.Interface(obj, 'com.victronenergy.BusItem').SetValue(dbus.String(args.ssid))
    print('AP password saved privately; SSID set. Enable through RoadLink GUI.')
    sys.exit(0)
if args.command == 'safe-mode':
    if os.geteuid() != 0:
        parser.error('Root required')
    path = Path('/data/setupOptions/RoadLink/SAFE_MODE')
    path.parent.mkdir(parents=True, exist_ok=True)
    path.touch(mode=0o600)
    print('Safe mode requested; RoadLink AP will stop. Native Ethernet remains unchanged.')
    sys.exit(0)
if args.command == 'ap-status':
    state = load_json('/run/roadlink-ap/status.json', {'state': 'OFF'})
    if load_json('/run/roadlink-ap/result.json', {}).get('cleaned'):
        state = {'state': 'OFF', 'internet': False}
    print(json.dumps(state, ensure_ascii=False, indent=2))
    sys.exit(0)
state = snapshot()
if args.command == 'hardware':
    for item in state['interfaces']:
        if item['wireless']:
            item['capabilities'] = capabilities(item['interface'])
    state = state['interfaces']
print(json.dumps(state, ensure_ascii=False, indent=2))
