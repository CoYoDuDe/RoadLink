#!/usr/bin/env python3
"""RoadLink diagnostics, private AP configuration and recovery CLI."""
import argparse
import json
import sys
import os
import getpass
import secrets
from pathlib import Path
sys.path.insert(0, str(Path(__file__).resolve().parent / 'src'))
from status import snapshot
from hardware import capabilities
from storage import load_json, write_json
from ap_config import hostapd
from profiles import Profiles

parser = argparse.ArgumentParser(description='RoadLink: Netzwerk prüfen und einrichten')
parser.add_argument('command', choices=['status', 'hardware', 'diagnostics', 'configure-ap', 'ap-status', 'safe-mode',
                                      'wifi-list', 'wifi-save', 'wifi-forget', 'vpn-public-key',
                                      'configure-vpn', 'vpn-disable', 'vpn-status'])
parser.add_argument('--ssid', default='RoadLink')
parser.add_argument('--generate', action='store_true', help='Eigenes WLAN-Passwort auf diesem Gerät erzeugen')
parser.add_argument('--security', choices=['psk', 'open'], default='psk')
parser.add_argument('--priority', type=int, default=50)
parser.add_argument('--autoconnect', action='store_true')
parser.add_argument('--id', dest='profile_id')
parser.add_argument('--endpoint')
parser.add_argument('--server-key')
parser.add_argument('--address')
parser.add_argument('--dns')
parser.add_argument('--port', type=int, default=51820)
parser.add_argument('--enable', action='store_true')
args = parser.parse_args()
if args.command == 'vpn-status':
    print(json.dumps(load_json('/run/roadlink-vpn/status.json', {'state': 'OFF'}), indent=2))
    sys.exit(0)
if args.command in ('configure-vpn', 'vpn-disable'):
    if os.geteuid() != 0:
        parser.error('Root-Rechte erforderlich')
    from vpn_config import read, save
    if args.command == 'vpn-disable':
        value = read()
        if value:
            save(dict(value, enabled=False))
        print('VPN wird ausgeschaltet. Der normale Gerätezugang bleibt erhalten.')
    else:
        if not all((args.endpoint, args.server_key, args.address, args.dns)):
            parser.error('--endpoint, --server-key, --address und --dns sind erforderlich')
        from wireguard import ensure_public_key
        ensure_public_key()
        try:
            save({'enabled': args.enable, 'endpoint': args.endpoint, 'public_key': args.server_key,
                  'address': args.address, 'dns': args.dns, 'port': args.port})
        except (ValueError, KeyError):
            parser.error('Ungültige VPN-Konfiguration')
        print('VPN gespeichert. Das Fahrzeug-WLAN erhält Internet, sobald Tunnel und DNS geprüft sind.')
    sys.exit(0)
if args.command == 'vpn-public-key':
    from wireguard import ensure_public_key
    print(ensure_public_key())
    sys.exit(0)
if args.command.startswith('wifi-'):
    if os.geteuid() != 0:
        parser.error('Root-Rechte erforderlich')
    profiles = Profiles()
    if args.command == 'wifi-save':
        # An explicit SSID is required; the AP default must never become an
        # unintended external WLAN profile.
        if '--ssid' not in sys.argv:
            parser.error('--ssid ist erforderlich')
        password = getpass.getpass('Externes WLAN-Passwort (leer: bisheriges behalten): ') if args.security == 'psk' else ''
        try:
            identifier = profiles.save(args.ssid, args.security, password, args.priority, args.autoconnect)
        except ValueError as error:
            parser.error(str(error))
        print('WLAN gespeichert: ' + identifier + '. Automatische Verbindung nur bei entsprechender Freigabe.')
    elif args.command == 'wifi-forget':
        if not args.profile_id:
            parser.error('--id ist erforderlich')
        profiles.forget(args.profile_id)
        print('WLAN entfernt.')
    else:
        print(json.dumps(profiles.metadata(), ensure_ascii=False, indent=2))
    sys.exit(0)
if args.command == 'configure-ap':
    if os.geteuid() != 0:
        parser.error('Root-Rechte erforderlich')
    password = secrets.token_urlsafe(18) if args.generate else getpass.getpass('Fahrzeug-WLAN-Passwort: ')
    hostapd('aproadlink', args.ssid, password)
    write_json('/data/setupOptions/RoadLink/ap-secret.json', {'password': password})
    import dbus
    obj = dbus.SystemBus().get_object('com.victronenergy.settings', '/Settings/RoadLink/AP/SSID')
    dbus.Interface(obj, 'com.victronenergy.BusItem').SetValue(dbus.String(args.ssid))
    print('WLAN-Name und Passwort lokal gespeichert. Fahrzeug-WLAN im RoadLink-Menü einschalten.')
    sys.exit(0)
if args.command == 'safe-mode':
    if os.geteuid() != 0:
        parser.error('Root-Rechte erforderlich')
    path = Path('/data/setupOptions/RoadLink/SAFE_MODE')
    path.parent.mkdir(parents=True, exist_ok=True)
    path.touch(mode=0o600)
    print('Sicherheitsmodus aktiviert: Fahrzeug-WLAN wird ausgeschaltet. Ethernet bleibt erhalten.')
    sys.exit(0)
if args.command == 'ap-status':
    state = load_json('/run/roadlink-ap/status.json', {'state': 'OFF'})
    if load_json('/run/roadlink-ap/result.json', {}).get('cleaned'):
        state = {'state': 'OFF', 'internet': False}
    print(json.dumps(state, ensure_ascii=False, indent=2))
    sys.exit(0)
state = snapshot()
if args.command == 'hardware':
    for item in state['interfaces']:
        if item['wireless']:
            item['capabilities'] = capabilities(item['interface'])
    state = state['interfaces']
print(json.dumps(state, ensure_ascii=False, indent=2))
