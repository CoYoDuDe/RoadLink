#!/bin/bash

standardPromptAndActions='no'

# SetupHelper 9.4 selects its patch tool only for INSTALL/CHECK. UNINSTALL
# still needs it to reverse our menu patch without removing other addons.
if /data/SetupHelper/patch -v >/dev/null 2>&1; then
    patch='/data/SetupHelper/patch --force --silent --reject-file=/dev/null'
elif /data/SetupHelper/patchBookworm -v >/dev/null 2>&1; then
    patch='/data/SetupHelper/patchBookworm --force --silent --reject-file=/dev/null'
else
    echo 'No compatible SetupHelper patch executable; leaving installed files unchanged.' >&2
    exit 245
fi

source "/data/SetupHelper/HelperResources/IncludeHelpers"

# SetupHelper 9.4 can promote an updated addon-only file to .orig even
# when NO_ORIG already records that no native file existed. Preserve that
# marker for our dedicated QML files; delegate every other backup unchanged.
eval "$(declare -f backupActiveFile | sed '1s/backupActiveFile/roadlinkOriginalBackupActiveFile/')"
backupActiveFile ()
{
    case "$1" in
        /opt/victronenergy/gui/qml/PageRoadLink*.qml|/opt/victronenergy/gui/qml/PageSettingsRoadLink.qml|/opt/victronenergy/gui/qml/RoadLinkPasswordEditor.qml)
            if [ -f "$1.NO_ORIG" ] && ! [ -e "$1.orig" ]; then
                return 1
            fi
            ;;
    esac
    roadlinkOriginalBackupActiveFile "$@"
}

if [ "$scriptAction" = 'NONE' ]; then
    standardActionPrompt
fi
if [ "$scriptAction" = 'INSTALL' ] || [ "$scriptAction" = 'UNINSTALL' ]; then
    if ! python3 "$scriptDir/src/qml_backups.py"; then
        logMessage 'RoadLink GUI backup repair failed; leaving installed files intact'
        exit 245
    fi
    if [ -d /service/com.coyodude.roadlink ]; then
        svc -d /service/com.coyodude.roadlink
    fi
    if ! python3 "$scriptDir/src/ap_runtime.py" stop; then
        logMessage 'RoadLink AP cleanup failed; leaving installed files intact'
        exit 245
    fi
    if [ -f "$scriptDir/src/wan_runtime.py" ] && ! python3 "$scriptDir/src/wan_runtime.py" stop; then
        logMessage 'RoadLink WAN cleanup failed; leaving installed files intact'
        exit 245
    fi
    if ! python3 "$scriptDir/src/vpn_runtime.py" stop; then
        logMessage 'RoadLink VPN cleanup failed; leaving installed files intact'
        exit 245
    fi
fi
endScript 'INSTALL_FILES' 'INSTALL_SERVICES' 'ADD_DBUS_SETTINGS'
